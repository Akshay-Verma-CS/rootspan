{
  "name": "rootspan-docs",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "validate": "node scripts/validate-build.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm validate"
  },
  "dependencies": {
    "lucide-react": "^0.550.0",
    "marked": "^16.4.1",
    "mermaid": "^11.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
